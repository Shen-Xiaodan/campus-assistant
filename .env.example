# Copy to .env and fill in your own key. Never commit real secrets.
APP_NAME=校园知识问答助手

# SiliconFlow uses an OpenAI-compatible chat API.
LLM_PROVIDER=siliconflow
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL_ID=Qwen/Qwen3-32B
LLM_TIMEOUT=300

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DATA_DIR=./data
INDEX_DIR=./vector_db_dir
CHROMA_COLLECTION=campus_documents
DISTANCE_METRIC=cosine
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
FETCH_K=12
# “有哪些/全部/列出”等汇总问题使用更宽的检索，并限制单文档占用名额。
AGGREGATE_TOP_K=10
AGGREGATE_FETCH_K=30
AGGREGATE_MAX_CHUNKS_PER_DOCUMENT=2
SIMILARITY_THRESHOLD=0.40
KEYWORD_BONUS_WEIGHT=0.25
HYBRID_SEARCH=true
MAX_EXCERPT_CHARS=240
LOG_LEVEL=INFO
API_URL=http://127.0.0.1:8000
